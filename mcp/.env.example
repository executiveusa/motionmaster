# Motion Master MCP server — environment
#
# Copy this file to `.env` and fill it in, or export the variables directly.
# Every value below is a PLACEHOLDER. Never commit a real token, key or URL.
# The server reads its configuration from the process environment only; it
# never writes a secret to disk and never sends one anywhere except the
# Montage instance you point it at.

# Port and host the MCP server listens on.
MOTION_MASTER_MCP_HOST=127.0.0.1
MOTION_MASTER_MCP_PORT=8787

# The URL the server advertises to MCP clients.
MOTION_MASTER_MCP_URL_PUBLIC=http://127.0.0.1:8787/mcp

# Where the plugin package, the token file and the clip manifest live.
# Leave these unset to use the repository layout.
# MOTION_MASTER_REPO_ROOT=/absolute/path/to/motion-master
# MOTION_MASTER_SKILLS_DIR=/absolute/path/to/motion-master/plugins/motion-master/skills
# MOTION_MASTER_TOKENS_PATH=/absolute/path/to/motion-master/plugins/motion-master/assets/motion-tokens.json
# MOTION_MASTER_CLIPS_PATH=/absolute/path/to/motion-master/site/src/clips.json
# MOTION_MASTER_BRAND_PATH=/absolute/path/to/motion-master/plugins/motion-master/assets/brand.json

# The Montage instance you run yourself. Leave it unset if you do not mix
# footage; mix_footage then says so instead of pretending to deliver.
# MOTION_MASTER_MONTAGE_URL=http://127.0.0.1:8000

# Only needed when the Montage instance runs in hosted auth mode. Local mode
# uses the tenant header instead.
# MOTION_MASTER_MONTAGE_TOKEN=replace-me-with-your-token

# The tenant that owns the Montage projects (local auth mode).
# MOTION_MASTER_MONTAGE_TENANT=tenant_owner

# How long the server waits for the Montage instance, in milliseconds.
# MOTION_MASTER_MONTAGE_TIMEOUT_MS=8000
