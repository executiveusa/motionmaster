node_modules/
dist/
build/
.cache/
*.log

# The four proof clips DO ship: they are the landing page's product proof, and a
# clone that cannot show a real rendered clip cannot show the page. They are
# reproducible with clips/render-all.sh, which also documents the poster times.
# clips/public/ (the footage stand-in source) stays out — it is an input.

# Local review artefacts
.review/
site/screenshots/

# The hero film's intermediate frame sequences: 118 MB of PNGs that are
# regenerated from site/public/clips by hero/render.mjs. The finished MP4 is
# committed; the frames it was cut from are not.
hero/frames/
hero/stills/
hero/.chrome-profile/

# Plan and prompt working files
.mavis/

.DS_Store
.env
.env.local
*.pem

# HyperFrames check artefacts: lint reports, snapshots and layout probes.
# The composition and the finished MP4 are committed; the reports are not.
.hyperframes/
generator/compositions/*/.hyperframes/

# The sample film is committed; its frame sequences are not.
generator/compositions/*/frames/

# The workspace: rendered films, their stills and the gate's verdicts. These are
# output, not source — a film is made again by asking the agent for it.
workspace/

# The gate's per-film snapshot artefacts.
generator/films/*/stills/
generator/films/*/.hyperframes/

# Chrome's own profile directories. They are created by the render scripts and
# they are never source: a cache of nothing, several megabytes each.
.chrome-profile/
**/.chrome-profile/

# The site's copy of the sound library. The audio lives in library/sfx and is
# copied into the site at build time, so the repository holds one copy of it.
site/public/sfx/

# Python bytecode from the vendored earshot package.
__pycache__/
*.pyc
